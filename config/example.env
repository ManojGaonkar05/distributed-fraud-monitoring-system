# Copy to .env on the relevant VM and change hostnames for your lab network.
KAFKA_BOOTSTRAP_SERVERS=vm1:9092
KAFKA_TOPIC=transactions-run1
KAFKA_CLIENT_ID=fraud-producer
TRANSACTIONS_CSV=data/transactions.csv
PRODUCER_INTERVAL_SECONDS=0.05
PRODUCER_DUPLICATE_EVERY=0
PRODUCER_DISORDER_SECONDS=0

SPARK_MASTER=spark://vm2:7077
SPARK_MASTER_HOST=vm2
SPARK_DRIVER_HOST=vm2
SPARK_DRIVER_PORT=39001
SPARK_BLOCKMANAGER_PORT=39002
RUN_ID=run1
HDFS_NAMENODE_URI=hdfs://vm3:9000
HDFS_CHECKPOINT_ROOT=hdfs://vm3:9000/checkpoints
ICEBERG_CATALOG=lab
ICEBERG_WAREHOUSE=hdfs://vm3:9000/warehouse
SPARK_THRIFT_HOST=vm4
SPARK_THRIFT_PORT=10000
SPARK_THRIFT_USER=fraud-user

R3_AMOUNT_THRESHOLD_INR=600000
WATERMARK_DELAY=1 minute
WINDOW_DURATION=2 minutes
WINDOW_SLIDE=30 seconds

# Dashboard / verifier export locations; export Iceberg tables as CSV here.
TRANSACTION_DECISIONS_CSV=exports/transaction_decisions.csv
ACCOUNT_RISK_ALERTS_CSV=exports/account_risk_alerts.csv
GROUND_TRUTH_DECISIONS_CSV=data/ground_truth_transaction_decisions.csv
GROUND_TRUTH_ALERTS_CSV=data/ground_truth_account_risk_alerts.csv
VERIFICATION_REPORT=reports/verification.json
